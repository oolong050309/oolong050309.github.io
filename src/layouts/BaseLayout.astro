---
import { pageHref, siteRevision } from '../lib/navigation';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { getAllPosts } from '../lib/content';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  language?: 'zh-CN' | 'en';
  alternates?: { language: string; href: string }[];
  publishedAt?: string;
  category?: string;
  subcategory?: string;
  tags?: string[];
}
const {
  title = site.title,
  description = site.description,
  article = false,
  language = site.language,
  alternates = [],
  publishedAt,
  category,
  subcategory,
  tags = [],
} = Astro.props;
const english = language === 'en';
const pathname = Astro.url.pathname;
const canonicalURL = Astro.site ? new URL(pathname, Astro.site) : undefined;
const keywords = [...new Set([category, subcategory, ...tags].filter((item): item is string => Boolean(item && item.trim())))];
const structuredData = canonicalURL
  ? article
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title.replace(` · ${site.name}`, ''),
        description,
        inLanguage: language,
        url: canonicalURL.href,
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
        ...(publishedAt ? { datePublished: publishedAt } : {}),
        author: { '@type': 'Person', name: site.name, url: new URL('/', Astro.site).href },
        publisher: { '@type': 'Person', name: site.name, url: new URL('/', Astro.site).href },
        ...(keywords.length ? { keywords: keywords.join(', ') } : {}),
        ...(category ? { articleSection: [category, subcategory].filter(Boolean).join(' / ') } : {}),
      }
    : {
        '@context': 'https://schema.org',
        '@type': pathname === '/' ? 'WebSite' : pathname.startsWith('/blog/') ? 'CollectionPage' : 'WebPage',
        name: pathname === '/' ? site.name : title,
        headline: title,
        description,
        inLanguage: language,
        url: canonicalURL.href,
        ...(pathname === '/'
          ? { '@id': new URL('/#website', canonicalURL).href }
          : { isPartOf: { '@type': 'WebSite', '@id': new URL('/#website', canonicalURL).href } }),
      }
  : undefined;
const navigation = [
  { title: english ? 'Articles' : '文章', href: '/blog/' },
  { title: english ? 'Projects' : '作品', href: '/projects/' },
  { title: english ? 'Now' : '此刻', href: '/now/' },
  { title: english ? 'About' : '关于', href: '/about/' },
];
const searchPosts = getAllPosts().map(({ title, description, category, subcategory, topic, tags, href }) => ({ title, description, category, subcategory, topic, tags, href: pageHref(href) }));
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta name="theme-color" content="#ffffff" />
    {siteRevision && <meta name="site-revision" content={siteRevision} />}
    <meta name="robots" content={import.meta.env.DEV ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={english ? 'en_US' : 'zh_CN'} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    {article && publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {article && category && <meta property="article:section" content={category} />}
    {article && tags.map(tag => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {Astro.site && alternates.map(alternate => <link rel="alternate" hreflang={alternate.language} href={new URL(alternate.href, Astro.site)} />)}
    {!import.meta.env.DEV && <link rel="sitemap" href="/sitemap-index.xml" />}
    {article && canonicalURL && <meta name="giscus:backlink" content={canonicalURL} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} 的文章`} href="/rss.xml" />
    <title>{title}</title>
    {structuredData && <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
    <script is:inline>
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.dataset.motion = 'paused';
    </script>
  </head>
  <body id="top">
    <div class="reading-progress" data-reading-progress aria-hidden="true"></div>
    <a class="skip-link" href="#main">{english ? 'Skip to content' : '跳到正文'}</a>
    <div class="page-shell">
      <header class="site-header">
        <a class="brand" href={pageHref('/')} aria-label={english ? 'Pip, home' : 'Pip，返回首页'} aria-current={pathname === '/' ? 'page' : undefined}>{site.name}<span aria-hidden="true">.</span></a>
        <nav class="main-nav" aria-label={english ? 'Main navigation' : '主导航'}>
          {navigation.map(item => <a href={pageHref(item.href)} aria-current={pathname === item.href ? 'page' : pathname.startsWith(item.href) ? 'location' : undefined}>{item.title}</a>)}
          <button class="icon-button" type="button" data-search-open aria-label={english ? 'Search articles' : '搜索文章'}><Icon name="search" size={18} /></button>
        </nav>
      </header>
      <main id="main" class:list={['main-content', { 'article-content': article }]}><slot /></main>
      <footer class="site-footer" data-reveal>
        <p>© {new Date().getFullYear()} {site.name}</p>
        <div><a href="/rss.xml">RSS <span aria-hidden="true">↗</span></a><a href="#top">{english ? 'Back to top' : '回到顶部'} <span aria-hidden="true">↑</span></a></div>
      </footer>
    </div>
    <dialog id="search-dialog" class="search-dialog" aria-labelledby="search-title">
      <div class="search-dialog-header"><h2 id="search-title">{english ? 'Search articles' : '搜索文章'}</h2><button class="icon-button" type="button" data-close-search aria-label={english ? 'Close search' : '关闭搜索'}><Icon name="close" /></button></div>
      <label class="search-field"><span class="sr-only">{english ? 'Keywords' : '搜索关键词'}</span><Icon name="search" size={18} /><input id="search-input" type="search" placeholder={english ? 'Search…' : '输入关键词…'} autocomplete="off" /></label>
      <div id="search-results" aria-live="polite"></div>
      <p class="dialog-footnote"><kbd>Esc</kbd> {english ? 'Close' : '关闭'}</p>
    </dialog>
    <script id="search-data" type="application/json" set:html={JSON.stringify(searchPosts).replace(/</g, '\\u003c')} />
    <script src="../scripts/interactions.ts"></script>
  </body>
</html>
