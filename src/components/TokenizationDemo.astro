---
import { tokenizationTrace as trace, wordLevelTokens, wordLevelVocabulary, visibleSpaces } from '../lib/tokenization-demo';
import '../styles/tokenization-animation.css';

interface Props { language?: 'zh-CN' | 'en'; }
const { language = 'zh-CN' } = Astro.props;
const english = language === 'en';
const phases = english
  ? [{ phase: 0, label: 'Text' }, { phase: 1, label: 'Words' }, { phase: 4, label: 'Token IDs' }, { phase: 5, label: 'Decode' }]
  : [{ phase: 0, label: '原文' }, { phase: 1, label: '按词切分' }, { phase: 4, label: '编号' }, { phase: 5, label: '还原' }];
---
<section class="token-animation" id="tokenization-demo" data-tokenization-demo data-mode="word" data-language={language} aria-label={english ? 'Tokenization animation' : 'Tokenization 动画'}>
  <div class="modes" role="group" aria-label={english ? 'Tokenization method' : '分词方式'} hidden>
    <button type="button" data-tokenizer-mode="word" aria-pressed="true">{english ? 'Word-level' : '单词级'}</button>
    <button type="button" data-tokenizer-mode="bpe" aria-pressed="false">BPE（o200k_base）</button>
  </div>
  <div class="original"><p lang="en">{trace.text}</p><span class="encoding" id="encoding-note">{english ? 'Illustrative IDs' : '示例编号'}</span></div>
  <nav class="phases" aria-label={english ? 'Animation stages' : '动画阶段'} hidden>
    {phases.map(({ phase, label }) => <button type="button" data-phase={phase}>{label}</button>)}
  </nav>
  <p class="byte-note" id="byte-note" hidden>{english ? 'Small numbers are UTF-8 byte values.' : '下方小数字为 UTF-8 字节值。'}</p>
  <div class="board">
    <div class="workbench">
      <p id="fallback" class="fallback">{wordLevelTokens.map(token => visibleSpaces(token.text)).join('  |  ')}</p>
      <svg id="stage-svg" xmlns="http://www.w3.org/2000/svg" role="group" aria-label={english ? 'Text pieces' : '文本片段'} data-pending></svg>
      <div class="merge-equation" id="merge-equation" hidden></div>
      <div class="lookup" id="lookup" hidden><strong id="lookup-token"></strong><span aria-hidden="true">→</span><strong id="lookup-id"></strong></div>
    </div>
    <aside class="vocabulary">
      <table aria-label={english ? 'Vocabulary excerpt' : '词表节选'}>
        <thead><tr><th scope="col">Token</th><th scope="col">ID</th></tr></thead>
        <tbody id="vocab-rows">{wordLevelVocabulary.map(token => <tr><td>{visibleSpaces(token.text)}</td><td>{token.id}</td></tr>)}</tbody>
      </table>
    </aside>
  </div>
  <p class="space-note" id="space-note">{english ? '␣ marks a space in the original text. Spaces and punctuation are kept as separate tokens here.' : '␣ 表示原文中的一个空格，这里将空格和标点单独保留。'}</p>
  <div class="sequence" id="sequence" aria-label={english ? 'Token ID sequence' : 'Token 编号序列'}>
    <div class="id-sequence" id="id-sequence">[{wordLevelTokens.map(token => token.id).join(', ')}]</div>
  </div>
  <div class="decoded" id="decoded" hidden><span aria-hidden="true">↳</span><strong lang="en">{trace.text}</strong></div>
  <div class="controls" hidden>
    <button type="button" id="play" class="primary" aria-pressed="false">{english ? 'Play' : '播放'}</button>
    <button type="button" id="previous">{english ? 'Previous' : '上一步'}</button>
    <button type="button" id="next">{english ? 'Next' : '下一步'}</button>
    <button type="button" id="restart" class="quiet">{english ? 'Restart' : '重来'}</button>
    <label class="sr-only" for="progress">{english ? 'Animation step' : '动画步骤'}</label>
    <input id="progress" type="range" min="0" max="11" value="0" step="1" />
  </div>
  <p class="sr-only" id="status" role="status" aria-live="polite" aria-atomic="true"></p>
</section>

<script src="../scripts/tokenization-demo.ts"></script>
