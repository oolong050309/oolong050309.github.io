---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from './PageHeader.astro';
import PostList from './PostList.astro';
import CategoryNav from './CategoryNav.astro';
import { articleCategories, type CategorySlug } from '../config/categories';
import { getPosts } from '../lib/content';
interface Props { category?: CategorySlug; }
const { category } = Astro.props;
const selected = articleCategories.find(item => item.slug === category);
const allPosts = getPosts();
const posts = selected ? allPosts.filter(post => post.category === selected.label) : allPosts;
const title = selected?.label || '文章';
const description = selected?.description || '从基础知识到开发实践、研究笔记，也记录阅读与生活里的想法。';
---
<BaseLayout title={`${title} · Pip`} description={description}>
  <PageHeader title={title} description={description}>
    <span>{selected ? '这个分类' : '全部'}共 {posts.length} 篇文章</span><a href="/rss.xml">RSS 订阅 <span aria-hidden="true">↗</span></a>
  </PageHeader>
  <CategoryNav selected={category || 'all'} posts={allPosts} />
  <section class="archive-section has-categories" aria-label={selected ? `${selected.label}文章` : '全部文章'}>
    {posts.length > 0 ? <PostList posts={posts} detailed /> : <div class="category-empty"><h2>还没有公开的{title}</h2><p>{selected?.description || '第一篇文章发布后，会出现在这里。'}</p><a class="section-more" href="/blog/">先读其他文章 <span aria-hidden="true">↗</span></a></div>}
  </section>
</BaseLayout>
