---
import { pageHref } from '../lib/navigation';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeCompanions from '../components/HomeCompanions.astro';
import ParticleOrb from '../components/ParticleOrb.astro';
import SideAtmosphere from '../components/SideAtmosphere.astro';
import PostList from '../components/PostList.astro';
import ProjectList from '../components/ProjectList.astro';
import { getPosts } from '../lib/content';
import { now } from '../config/now';
import { about } from '../config/about';
const posts = getPosts().slice(0, 3);
const currentActivities = now.items.filter(item => !item.pending);
---
<BaseLayout>
  <SideAtmosphere />
  <HomeCompanions />
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">Hi, I'm <span class="hero-name"><span class="sr-only">Pip</span><span data-scramble aria-hidden="true">Pip</span></span><span class="hero-period">.</span></h1>
      <p class="hero-description">慢慢学，认真想，动手做。</p>
      <p class="hero-note">这里记录计算机知识、动手做的小东西，<br />以及生活里的新想法。</p>
      <a class="hero-read-link" href={pageHref('/blog/')}>浏览文章 <span aria-hidden="true">↗</span></a>
    </div>
    <ParticleOrb />
  </section>

  <section class="writing-section" id="writing" aria-labelledby="writing-title">
    <div class="section-heading" data-reveal><h2 id="writing-title">最近的文章</h2><a class="section-more" href={pageHref('/blog/')}>全部文章 <span aria-hidden="true">↗</span></a></div>
    {posts.length > 0 ? <PostList posts={posts} /> : <p class="posts-empty">文章正在整理中，敬请期待。</p>}
  </section>

  <section class="projects-section" id="projects" aria-labelledby="projects-title">
    <div class="section-heading" data-reveal><h2 id="projects-title">作品与实验</h2><a class="section-more" href={pageHref('/projects/')}>全部作品 <span aria-hidden="true">↗</span></a></div>
    <ProjectList />
  </section>

  <section class="now-section" id="now" aria-labelledby="now-title">
    <div class="section-heading" data-reveal><h2 id="now-title">此刻</h2><span class="section-note">更新于 <time datetime={now.updatedAt}>{now.updatedAt.replaceAll('-', '.')}</time></span></div>
    <dl class="now-list">
      {currentActivities.map(item => <div class="now-item" data-reveal><dt>{item.label}</dt><dd>{item.text}</dd></div>)}
    </dl>
    <a class="section-follow-link" href={pageHref('/now/')}>更多近况 <span aria-hidden="true">↗</span></a>
  </section>

  <section class="about-section" id="about" aria-labelledby="about-title" data-reveal>
    <h2 id="about-title">关于我</h2>
    <div><p>{about.intro}</p><a class="about-rss" href={pageHref('/about/')}>认识 Pip <span aria-hidden="true">↗</span></a></div>
  </section>
</BaseLayout>
