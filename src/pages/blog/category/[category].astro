---
import BlogArchive from '../../../components/BlogArchive.astro';
import { articleCategories, articleSubcategories, type CategorySlug, type SubcategorySlug } from '../../../config/categories';

export function getStaticPaths() {
  return [
    ...articleCategories.map(category => ({ params: { category: category.slug }, props: { category: category.slug } })),
    ...articleSubcategories.map(subcategory => ({ params: { category: subcategory.slug }, props: { category: subcategory.parent, subcategory: subcategory.slug } })),
  ];
}
interface Props { category: CategorySlug; subcategory?: SubcategorySlug; }
const { category, subcategory } = Astro.props;
---
<BlogArchive category={category} subcategory={subcategory} />
