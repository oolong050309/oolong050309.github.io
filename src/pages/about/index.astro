---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { about } from '../../config/about';
---
<BaseLayout title="关于 · Pip" description="认识 Pip，以及这个个人网站想记录和分享的东西。">
  <PageHeader title="关于 Pip" description={about.intro} />
  <div class="page-body">
    {about.sections.map(section => <section class="content-block" data-reveal><h2>{section.title}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}</section>)}
    <div class="page-actions"><a class="section-more" href="/blog/">从文章认识我 <span aria-hidden="true">↗</span></a><a class="section-more" href="/rss.xml">RSS 订阅 <span aria-hidden="true">↗</span></a></div>
  </div>
</BaseLayout>
